# This is the Win2k/ME theme IceWM's menu definition file.
# Merge with your own menu file or
# Place in $HOME/.icewm


#prog "Add/Remove Programs" synaptic ~/.icewm/programs/sudo2k/sudo2k synaptic
include "~/.icewm/menu-top"
# include menu
separator
# If you would like a Documents style submenu
# Copy "documents.sh" to your home dir and set execute permission
# menuprog "Dokumenty" documents ./documents.sh

# menuprog "prog" programs wmmenugen -parser:xdg /usr/share/applications

# See /usr/share/icewm/menu for more examples on how to configure
menu "Programy" programs {
	menu "Akcesoria" folder {
		menu "Gry" folder {
			prog "Freecell" ace ace-freecell
			prog "Saper" ace ace-minesweeper
			prog "Pasjans" ace ace-solitaire
			separator
			prog "Neverball" neverball neverball
			prog "SuperTuxKart" supertuxkart supertuxkart
			prog "Xye" xye xye
		}
		prog "Książka adresowa" addressbook xterm -fn fixed -e abook
		prog "Kalkulator" calculator xcalc
		prog "Wiersz polecenia" x-terminal-emulator xterm
		prog "Imaging" xfi xfi
		prog "Notatnik" xfw xfw
		prog "Eksplorator Windows" xfe xfe
		prog "WordPad" abiword abiword
	}

	prog "Internet Explorer" web-browser firefox-esr
	prog "Outlook Express" thunderbird xterm -e mutt
	separator
	includeprog icewm-menu-fdo --no-sub-cats

}

menu "Pulpit" desktop {
	menu "Active Desktop" "" {
		includeprog ~/.icewm/programs/explorer/desktopicons menu
	}
	separator
	menu "Rozmieść ikony" "" {
		prog "" "" true
	}
	prog "Odśwież" "" "~/.icewm/programs/panel/refreshdesktop"
	separator
	prog "Wklej" "" "true"
	prog "Wklej skrót" "" "true"
	separator
	menu "Nowy" "" {
		prog "" "" "true"
	}
	separator
	#prog "Właściwości" "" "~/.icewm/programs/control/cpls-bin/wallswitcher/wallswitcher"
	prog "Właściwości" "" desk.cpi
}
menu "_Dokumenty" documents {
	prog "Mój Komputer" computer xfe /
	prog "Moje Dokumenty" documents xfe
}
menu "Ustawienia" settings {
	#prog "Panel sterowania" settings sh -c "$HOME/.icewm/programs/control/control"
	prog "Panel sterowania" settings control
	#prog "Konfiguracja IceWM" settings uxterm -e "nano ~/.icewm/preferences"
	prog "Drukarki" printer xdg-open localhost:631/admin
	menuprog "Monitory" computer icewm-menu-xrandr
} 
menu "Wyszukaj" search {
	prog "Pliki lub foldery..." search spacefm -f
}
prog "Pomoc" help xman
prog "Uruchom..." run runbox
separator
#prog "Zamknij..." shutdown ~/.icewm/programs/shutdown/shutdown
prog "Zamknij..." shutdown shutdlg

#includeprog sh -c 'nohup xterm > /dev/null 2>&1 &'
#includeprog sh -c 'yad --close-on-unfocus --mouse >/dev/null 2>&1 &'

